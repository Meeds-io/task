 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
 * Lesser General Public License for more details.
 * You should have received a copy of the GNU Lesser General Public License
 * along with this program; if not, write to the Free Software Foundation,
 * Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.
 */
%>
<style>
  a{
    color: ${io.meeds.portal.mail.EmailLayout.linkColor()};
    text-decoration: none;
    font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};
  }
</style>
<table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="width:100%;overflow-wrap:anywhere;word-break:break-word;background-color: #ffffff; font-size: 15px;color: #1d2327;line-height: 1.7;font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="${io.meeds.portal.mail.EmailLayout.dir(_ctx.language)}">
    <%
      _templateContext.put("header_title", _ctx.appRes("Notification.title.TaskDueDatePlugin"));
      _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
    <tr>
        <td style="padding:0 24px;">
            <table role="presentation" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="max-width:600px;margin:0 auto;background-color: #ffffff;">
                <tr>
                    <td bgcolor="#ffffff" style="background-color: #ffffff;">
                        <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="background-color: #ffffff; color: #1d2327;line-height: 1.7;">
                            <tr>
                                <td align="${io.meeds.portal.mail.EmailLayout.start(_ctx.language)}" bgcolor="#ffffff" style="background-color: #ffffff;padding: 30px 0 10px 0;">
                                    <p style="margin: 0 0 14px; font-size: 15px; color: #1d2327; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};">
                                        <%=_ctx.appRes("Notification.label.SayHello")%> $FIRST_NAME,</p>
                                    <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="background-color: #ffffff; font-size: 15px;color: #1d2327;line-height: 1.7;">
                                        <tbody>
                                            <tr>
                                                <td align="${io.meeds.portal.mail.EmailLayout.start(_ctx.language)}" style="padding: 0;">
                                                    <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="width: 100%; background-color: #ffffff; font-size: 15px; color: #1d2327;line-height: 1.7;">
                                                        <tr>
                                                            <!--[if mso]>
<td width="64" align="${io.meeds.portal.mail.EmailLayout.start(_ctx.language)}" valign="top" bgcolor="#ffffff" style="vertical-align: top; background-color: #ffffff; ">
                                                                <img width="44" height="44" style="margin-top: 2px; border-radius: 50%;" src="$AVATAR" alt="$USER" />
                                                            </td>
<![endif]-->
<td width="64" align="${io.meeds.portal.mail.EmailLayout.start(_ctx.language)}" valign="top" bgcolor="#ffffff" style="mso-hide:all; vertical-align: top; background-color: #ffffff; ">
                                                                <img width="44" height="44" style="margin-top: 2px; border-radius: 50%;" src="$AVATAR" alt="$USER" />
                                                            </td>
                                                            <td align="${io.meeds.portal.mail.EmailLayout.start(_ctx.language)}" bgcolor="#ffffff" style="background-color: #ffffff; padding: 0 0; vertical-align: top;">
                                                                <p style="margin:0 0 14px; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="auto">
                                                                   <%
                                                    String profileUrl = "<a target=\"_blank\" style=\"color: ${io.meeds.portal.mail.EmailLayout.linkColor()}; text-decoration: none; font-weight: bold; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};\" href=\""+ PROFILE_URL + "\">" + USER + "</a>";
                                                    def msg = _ctx.appRes("Notification.message.email.TaskDueDatePlugin", profileUrl);
                                                    if (PROJECT_NAME != null && !PROJECT_NAME.isEmpty()) {
                                                      msg +=  " " + _ctx.appRes("Notification.message.inProject",
                                                                          " <a target=\"_blank\" style=\"color: ${io.meeds.portal.mail.EmailLayout.linkColor()}; text-decoration: none; font-weight: bold; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};\" href=\""+ PROJECT_URL + "\">" + PROJECT_NAME + "</a>");
                                                    }
                                                  %>
                                                  <%=msg%> <%=_ctx.appRes("Notification.message.onTask")%>:
                                                                </p>

                                                                <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="margin:0 0 10px; width: 100%; background-color: #ffffff; font-size: 15px; color: #1d2327;line-height: 1.7;">
                                                                    <tr>
                                                                        <td align="${io.meeds.portal.mail.EmailLayout.start(_ctx.language)}" valign="top" bgcolor="#ffffff" style="vertical-align: top; background-color: #ffffff; padding: 0;" dir="auto">
                                                                            <p style="margin:0 0 14px; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="auto">
                                                                            <a target="_blank" style="color: ${io.meeds.portal.mail.EmailLayout.linkColor()}; text-decoration: none; font-weight: bold; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" href="$TASK_URL">
                                                                               <strong>$TASK_TITLE</strong>
                                                                            </a>
                                                                            </p>
                                                                            <%if (TASK_DESCRIPTION != null && !TASK_DESCRIPTION.isEmpty()) { %>
                                                                            <%=io.meeds.portal.mail.EmailLayout.quoteStart(_ctx.language)%>$TASK_DESCRIPTION<%=io.meeds.portal.mail.EmailLayout.quoteEnd()%>
                                                                            <%} %>
                                                                            <%if (DUE_DATE != null && !DUE_DATE.isEmpty()) { %>
                                                                            <div style="margin:0 0 14px; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="auto">
                                                                                <%=_ctx.appRes("Notification.label.dueOn")%> <strong>$DUE_DATE</strong>
                                                                            </div>
                                                                            <%} %>
                                                                        </td>
                                                                    </tr>
                                                                    <tr>

                                                                        <td align="${io.meeds.portal.mail.EmailLayout.start(_ctx.language)}" valign="top" bgcolor="#ffffff" style="vertical-align: top; background-color: #ffffff; padding: 0;">
                                                                            
                                                                        </td>
                                                                    </tr>
                                                                </table>
<div dir="${io.meeds.portal.mail.EmailLayout.dir(_ctx.language)}" style="margin: 20px 0 8px 0;">

                                                                                <%=io.meeds.portal.mail.EmailLayout.actionLink(_ctx.appRes("Notification.label.openTask"), "$TASK_URL", true)%>
                                                                            </div>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <p style="margin:28px 0 0 0; color: #5d676d;font-size: 13px;font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()}">
                                       <%=io.meeds.portal.mail.EmailLayout.linkStyled(_ctx.appRes("Notification.label.footer.v2", "" + FOOTER_LINK))%>
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

        </td>
    </tr><!--end content area-->
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
</table>
