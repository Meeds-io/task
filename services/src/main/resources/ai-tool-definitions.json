    {
      "name": "create_task_in_project",
      "title": "Create a Task",
      "description": "Create a new task in the specified project.",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "integer",
            "description": "Project identifier where the task will be created."
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "assignee": {
            "type": "string",
            "description": "Optional username of the assignee."
          },
          "coworkers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional list of usernames to add as coworkers on the task."
          },
          "start_date": {
            "type": "string",
            "description": "Optional task start date as a string, parsed into a date."
          },
          "due_date": {
            "type": "string",
            "description": "Optional task due date as a string, parsed into a date."
          },
          "priority": {
            "type": "string",
            "enum": ["NONE", "LOW", "NORMAL", "HIGH"]
          },
          "status_id": {
            "type": "integer",
            "description": "Optional status identifier. If omitted, the project's default status is used."
          }
        },
        "required": ["project_id", "title"]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "require_approval": true
