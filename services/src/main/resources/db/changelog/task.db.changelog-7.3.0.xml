<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

  <!--
    A card's coworkers and labels are read by TASK_ID. MySQL (InnoDB) and HSQLDB
    already index that column for its foreign key; PostgreSQL, Oracle and SQL
    Server do not, so each lookup scans the whole table there. An index an
    administrator already created on TASK_ID alone is kept.
  -->
  <changeSet id="7.3.0-exo-92610-01" author="task" dbms="postgresql,oracle,mssql">
    <preConditions onFail="MARK_RAN">
      <not>
        <indexExists tableName="TASK_TASK_COWORKERS" columnNames="TASK_ID"/>
      </not>
    </preConditions>
    <createIndex indexName="IDX_TASK_TASK_COWORKERS_02" tableName="TASK_TASK_COWORKERS">
      <column name="TASK_ID"/>
    </createIndex>
  </changeSet>

  <changeSet id="7.3.0-exo-92610-02" author="task" dbms="postgresql,oracle,mssql">
    <preConditions onFail="MARK_RAN">
      <not>
        <indexExists tableName="TASK_LABEL_TASK" columnNames="TASK_ID"/>
      </not>
    </preConditions>
    <createIndex indexName="IDX_TASK_LABEL_TASK_02" tableName="TASK_LABEL_TASK">
      <column name="TASK_ID"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
